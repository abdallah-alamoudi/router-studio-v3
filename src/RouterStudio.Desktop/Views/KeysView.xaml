<UserControl x:Class="RouterStudio.Desktop.Views.KeysView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="Keys &amp; assignments" Style="{StaticResource PageHeading}"/>
  <TextBlock Text="Create the key with its intended group in 8stoken first. Labels here name saved credentials; they do not grant gateway permissions." Style="{StaticResource Subtitle}"/>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Independent saved credentials" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Save keys separately from model assignments. Names can change; identity stays the same. Legacy assignments below remain available." TextWrapping="Wrap" Margin="0,0,0,12"/>
   <ListBox x:Name="SavedCredentialList" ItemsSource="{Binding SavedCredentials.Items}" SelectedItem="{Binding SavedCredentials.Selected}" DisplayMemberPath="Label" IsEnabled="{Binding SavedCredentials.CanManage}" MaxHeight="180" AutomationProperties.Name="Independent saved credentials" Margin="0,0,0,12"/>
   <TextBlock Text="Display name (up to 80 characters)"/>
   <TextBox Text="{Binding SavedCredentials.Label,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding SavedCredentials.CanManage}" AutomationProperties.Name="Saved credential display name" Margin="0,8,0,12"/>
   <TextBlock Text="New or replacement key (masked; cleared on submission)"/>
   <PasswordBox x:Name="IndependentKeyPassword" IsEnabled="{Binding SavedCredentials.CanManage}" AutomationProperties.Name="Independent credential API key" Margin="0,8,0,12"/>
   <WrapPanel>
    <Button Content="New credential" Click="NewCredential" IsEnabled="{Binding SavedCredentials.CanManage}" Margin="0,0,8,8"/>
    <Button Content="Save new key" Click="SaveCredential" IsEnabled="{Binding SavedCredentials.CanManage}" Margin="0,0,8,8"/>
    <Button Content="Rename selected" Click="RenameCredential" IsEnabled="{Binding SavedCredentials.CanEdit}" Margin="0,0,8,8"/>
    <Button Content="Rotate selected key" Click="RotateCredential" IsEnabled="{Binding SavedCredentials.CanEdit}" Margin="0,0,8,8"/>
    <Button Content="Delete selected key" Click="DeleteCredential" IsEnabled="{Binding SavedCredentials.CanEdit}" Margin="0,0,8,8"/>
    <Button Content="Fetch selected key catalog…" Click="FetchCredentialCatalog" IsEnabled="{Binding SavedCredentials.CanEdit}" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock Text="Catalog fetch contacts 8stoken only after confirmation. Key rotation invalidates its catalog and disables dependent custom models until an explicit refresh. Deletes are refused while references exist. Saved changes stop the owned router; use Connections to restart it explicitly." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Saved labels and catalog references" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Keys.References}" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Add or replace a key" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Credential label (letters, numbers, underscore)" Margin="0,0,0,8"/>
   <TextBox x:Name="CredentialLabel" Text="{Binding Keys.Label,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Keys.CanPreview}" MaxLength="40" AutomationProperties.Name="Credential label" Margin="0,0,0,16"/>
   <TextBlock Text="Select raw models (Ctrl-click for multiple). Custom labels require a model; PLUS/PRO/FULL also update their supported presets." TextWrapping="Wrap" Margin="0,0,0,8"/>
   <ListBox x:Name="RawModels" ItemsSource="{Binding Keys.RawModels}" SelectionMode="Extended" DisplayMemberPath="Id" IsEnabled="{Binding Keys.CanPreview}" SelectionChanged="SelectionChanged" AutomationProperties.Name="Raw models for key assignment" MaxHeight="240" Margin="0,0,0,16"/>
   <Button x:Name="PreviewRoutesButton" Content="_Preview assignments" IsEnabled="{Binding Keys.CanPreview}" HorizontalAlignment="Left" Click="PreviewRoutes"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Review proposed assignments" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Keys.PreviewText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBlock Text="Paste key (masked; cleared on submission)" Margin="0,0,0,8"/>
   <PasswordBox x:Name="KeyPassword" AutomationProperties.Name="New or replacement API key" Margin="0,0,0,16"/>
   <TextBlock Text="Apply requires your work saved and Codex closed because the router restarts. Configuration changes after preview are refused. Unselected mappings stay unchanged." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
   <Button x:Name="ApplyKeyButton" Content="Review and _apply encrypted key" IsEnabled="{Binding Keys.CanApply}" HorizontalAlignment="Left" Click="ApplyKey"/>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
