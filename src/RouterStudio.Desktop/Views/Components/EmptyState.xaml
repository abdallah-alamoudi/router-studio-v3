<UserControl x:Class="RouterStudio.Desktop.Views.Components.EmptyState" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="○  COMING NEXT" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,16"/><TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="{Binding Description,RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><TextBlock Text="{Binding NextStep,RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap"/></Border></StackPanel></Border></UserControl>