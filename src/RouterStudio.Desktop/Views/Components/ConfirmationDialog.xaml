<Window Style="{StaticResource {x:Type Window}}" x:Class="RouterStudio.Desktop.Views.Components.ConfirmationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirm action" Width="480" Height="340" MinWidth="400" MinHeight="280" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="Heading" Style="{StaticResource PageHeading}"/><TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,24"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Content="_Confirm" Click="Confirm" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Window>