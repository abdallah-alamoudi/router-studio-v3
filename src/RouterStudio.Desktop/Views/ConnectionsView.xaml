<UserControl x:Class="RouterStudio.Desktop.Views.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="Choose how you connect" Style="{StaticResource PageHeading}"/>
  <TextBlock Text="Review the target, confirm the local change, then restart Codex and start a new session." Style="{StaticResource Subtitle}"/>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Current configured connection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Connections.Selected}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Connections.Endpoint}" TextWrapping="Wrap" Margin="0,8,0,8"/>
   <TextBlock Text="{Binding Connections.Protocol}" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,16,0,8"><TextBlock Text="Configuration review: "/><TextBlock Text="{Binding Dashboard.State.ReviewState}"/></WrapPanel>
   <TextBlock Text="Refresh locally before switching. Controls stay unavailable while status is unknown, out of date, needs review, or an action is running. Local checks also refresh every 15 seconds while this page is visible and idle." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Official ChatGPT" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Select official subscription configuration. Use ChatGPT sign-in to choose your account and Business workspace. Authentication, model access and quotas remain unverified here." TextWrapping="Wrap" Margin="0,0,0,16"/>
   <Button x:Name="OfficialButton" Content="Review _official selection" HorizontalAlignment="Left" IsEnabled="{Binding Connections.CanSelect}" Click="SelectOfficial"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="8stoken router" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Select the authenticated localhost Responses connection. The existing worker starts the local router. If saved files require a restart, confirmation acknowledges that your work is saved and Codex is closed." TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBlock Text="Local endpoint: http://127.0.0.1:18761/v1&#10;Upstream: https://8stoken.com · Access not tested" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
   <Button x:Name="RouterButton" Content="Review _router selection" HorizontalAlignment="Left" IsEnabled="{Binding Connections.CanSelect}" Click="SelectRouter"/>
  </StackPanel></Border>
  <TextBlock Text="Missing prerequisites or a blocked change? Read the safe Diagnostics message. Use the existing management window for installation, repair and backups during this preview." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
 </StackPanel>
</UserControl>
