<UserControl x:Class="RouterStudio.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
<TextBlock Text="Settings" Style="{StaticResource PageHeading}"/><TextBlock Text="Appearance, startup, local history and support details." Style="{StaticResource Subtitle}"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="First-time router setup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="For a new installation only. Existing encrypted keys and routes are reused automatically. Save work and close Codex before setup; it changes the default Codex connection and starts the local router." TextWrapping="Wrap" Margin="0,0,0,12"/><Label Content="Plus/default key (required)" Target="{Binding ElementName=SetupPlus}"/><PasswordBox x:Name="SetupPlus" MaxLength="8192" AutomationProperties.Name="Initial Plus key"/><Label Content="Pro key (optional)" Target="{Binding ElementName=SetupPro}"/><PasswordBox x:Name="SetupPro" MaxLength="8192" AutomationProperties.Name="Initial Pro key"/><Label Content="Full key (optional)" Target="{Binding ElementName=SetupFull}"/><PasswordBox x:Name="SetupFull" MaxLength="8192" AutomationProperties.Name="Initial Full key"/><Button x:Name="InstallRouterButton" Content="Review first-time setup" Click="InstallRouter" IsEnabled="{Binding CanMutate}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><Label Target="{Binding ElementName=ThemePicker}" Content="_Theme" Foreground="{DynamicResource TextBrush}"/><ComboBox x:Name="ThemePicker" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="220" MaxWidth="280" HorizontalAlignment="Left" AutomationProperties.Name="Theme"/><TextBlock Text="System follows your Windows app theme. Windows high contrast overrides all themes. Choices are saved for this Windows user." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Startup and tray" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox x:Name="CloseToTray" Content="Close window to tray; use Exit Studio to quit" IsChecked="{Binding Settings.CloseToTray}" Margin="0,0,0,12"/><CheckBox Content="Start Studio when I sign in to Windows" IsChecked="{Binding Settings.StartApp}" Margin="0,0,0,12"/><CheckBox Content="Start local router when I sign in to Windows" IsChecked="{Binding Settings.StartRouter}" Margin="0,0,0,12"/><TextBlock Text="Startup controls require packaged installation. A legacy router startup launcher is retained until you explicitly migrate it. Exiting Studio keeps the router running." TextWrapping="Wrap"/><TextBlock Text="{Binding Settings.Notice}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="History and support" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Up to 200 local action/test records for 30 days. No keys, request/response bodies or proxied activity are stored." TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding HistoryNotice}" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ClearHistoryButton" Content="Review _clear history" Click="ClearHistory" IsEnabled="{Binding CanMutate}" Margin="0,0,12,0"/><Button x:Name="ExportSupportButton" Content="_Export safe support details" Click="ExportSupport" IsEnabled="{Binding CanMutate}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Keyboard shortcuts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Alt+1–7    Open a page&#10;Ctrl+R     Read local status&#10;F8           Toggle diagnostics&#10;Escape   Close diagnostics&#10;Tab          Move between controls" TextWrapping="Wrap" LineHeight="28"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="About this preview" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Unsigned developer preview. Official sign-in, gateway access, physical display scaling and public-release acceptance remain separate checks." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
</StackPanel></UserControl>
