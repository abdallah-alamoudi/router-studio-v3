<Window Style="{StaticResource {x:Type Window}}" x:Class="RouterStudio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:RouterStudio.Desktop.Presentation" xmlns:c="clr-namespace:RouterStudio.Desktop.Views.Components"
 Title="Router Studio · Desktop preview" Width="1200" Height="800" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Window.InputBindings>
  <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/><KeyBinding Key="F8" Command="{Binding DiagnosticsCommand}"/><KeyBinding Key="Escape" Command="{Binding CloseDiagnosticsCommand}"/>
  <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.Dashboard}"/><KeyBinding Key="D2" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.Connections}"/>
  <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.ModelsRoutes}"/><KeyBinding Key="D4" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.Keys}"/>
  <KeyBinding Key="D5" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.TestLab}"/><KeyBinding Key="D6" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.Backups}"/><KeyBinding Key="D7" Modifiers="Alt" Command="{Binding NavigateCommand}" CommandParameter="{x:Static p:StudioPage.Settings}"/>
 </Window.InputBindings>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16,24">
   <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="ROUTER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Studio" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Desktop preview" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="8,24,8,0"><TextBlock Text="No provider tests on navigation." TextWrapping="Wrap" Margin="0,8,0,8"/><TextBlock Text="Alt+1–7 · Navigate&#10;Ctrl+R · Local refresh&#10;F8 · Diagnostics" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
   <ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" SelectedValuePath="Page" SelectedValue="{Binding CurrentPage}" AutomationProperties.Name="Main navigation" KeyboardNavigation.TabNavigation="Once">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Symbol}" Width="28" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Foreground}"/><TextBlock Text="{Binding Label}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Foreground}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16"><WrapPanel><StackPanel VerticalAlignment="Center" MaxWidth="360" Margin="0,0,16,8"><TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel><WrapPanel Margin="0,0,0,8"><Button x:Name="RefreshButton" Content="_Refresh locally" Command="{Binding RefreshCommand}" ToolTip="Read local status only (Ctrl+R)"/><Button Content="_Diagnostics" Command="{Binding DiagnosticsCommand}" Margin="8,0,0,0" ToolTip="Show safe error details (F8)"/></WrapPanel></WrapPanel></Border>
   <StackPanel Grid.Row="1" Margin="24,16,24,0"><c:LoadingState Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/><c:ErrorState Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"/></StackPanel>
   <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"/></ScrollViewer>
   <StackPanel Grid.Row="3" Margin="24,0,24,16">
    <TextBlock Text="! Connection change requested. Restart Codex, use the selected connection and start a new session. This app cannot detect what an existing session loaded." Visibility="{Binding CodexRestartRequired,Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="Desktop preview · Tests run only when requested. Authentication and quota need separate verification." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel>
  </Grid>
  <Border Grid.Column="2" Width="320" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding DiagnosticsOpen,Converter={StaticResource BoolVisibility}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Diagnostics" Style="{StaticResource PageHeading}"/><TextBlock Text="Safe local details. No keys or raw worker output." Style="{StaticResource Subtitle}"/><TextBlock Text="Last error code" FontWeight="SemiBold"/><TextBlock Text="{Binding DiagnosticCode}" Margin="0,8,0,24"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,24"/><TextBlock Text="If a local action fails, refresh status before making another change. Provider access has not been tested." TextWrapping="Wrap" Margin="0,0,0,24"/><Button x:Name="StartRouterButton" Content="Review router _start" IsEnabled="{Binding CanStartRouter}" Click="StartRouter" Margin="0,0,0,8"/><Button x:Name="RepairConnectionButton" Content="Review connection _repair" IsEnabled="{Binding CanRepair}" Click="RepairConnection" Margin="0,0,0,16"/><Button x:Name="CloseDiagnosticsButton" Content="_Close diagnostics" Command="{Binding CloseDiagnosticsCommand}"/></StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>
